  <section id="home" class="hero">
    <div class="hero-bg" id="heroBg"></div>
    <div class="container">
      <div class="hero-grid">
        <div>
          <div class="eyebrow">{{hero.info}}</div>
          <h1><a href="{{metadata.url}}" class="text-white">{{hero.title}}</a> — <br><em>{{hero.title2}}</em></h1>
          <h2>{{hero.description}}</h2>
           <div class="code-card trans">
            <div class="code-dots"><i></i><i></i><i></i></div>
            <pre class="code-pre" id="codePre"></pre>
          </div>
          <div style="margin-top:28px" class="hero-copy">
            <p><strong style="color:var(--sand)">{{hero.why.title}}</strong> {{hero.why.text}}</p>
            <p>{{hero.why.text1}}</p>
          </div>
          <div class="hero-actions">
            <a href="{{hero.button1.url}}" class="btn btn-primary"><span class="steampunk-icon">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
			><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 9 15a1.65 1.65 0 0 0-1-1.51V13a2 2 0 0 1 0-4v-.5a1.65 1.65 0 0 0 1-1.51 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 13.5 3c.26 0 .5.1.7.28A1.65 1.65 0 0 0 15 5V5.5a2 2 0 0 1 0 4v.5c0 .6.4 1.1 1 1.5Z"/></svg></span> 
            {{hero.button1.text}}</a>
            <a href="{{hero.button2.url}}" class="btn btn-ghost">{{hero.button2.text}}</a>
          </div>
        </div>
        <div>
          <div class="mission-grid trans" style="grid-template-columns:1fr">
            <div class="parch-card">
              <div class="rivet tl"></div>
			  <div class="rivet tr"></div><div class="rivet bl"></div><div class="rivet br"></div>
              <div class="card-icon">
			  <svg viewBox="0 0 24 24" fill="none" stroke="#b8860b" stroke-width="0.8">
          <rect x="3" y="3" width="18" height="18" rx="2"/>
          <rect x="5" y="5" width="14" height="14" rx="1.5" stroke-dasharray="0.5 1.5"/>
          <path d="M6 6l1.5 1.5M18 6l-1.5 1.5M6 18l1.5-1.5M18 18l-1.5-1.5"/>
          <path d="M12 4v2M12 18v2M4 12h2M18 12h2"/>
          <circle cx="12" cy="12" r="5"/>
          <circle cx="12" cy="12" r="3.5" stroke-dasharray="0.5 1"/>
          <path d="M12 7c-1 1.5-1 3.5 0 5"/>
          <path d="M12 17c1-1.5 1-3.5 0-5"/>
          <path d="M7 12c1.5 1 3.5 1 5 0"/>
          <path d="M17 12c-1.5 1-3.5 1-5 0"/>
          <circle cx="12" cy="12" r="1.8"/>
          <circle cx="12" cy="12" r="0.8" fill="#b8860b"/>
        </svg>
			  </div>
              <h3><a href="{{metadata.url}}" class="inhe">{{hero.mission.title}}</a></h3>
              <p>{{hero.mission.text}}</p>
            </div>
            <div class="parch-card">
              <div class="rivet tl"></div><div class="rivet tr"></div><div class="rivet bl"></div><div class="rivet br"></div>
              <div class="card-icon">
			  <svg viewBox="0 0 24 24" fill="none" stroke="#b8860b" stroke-width="0.8">
          <circle cx="12" cy="12" r="10"/>
          <circle cx="12" cy="12" r="8.5" stroke-dasharray="0.3 1.5"/>
          <circle cx="12" cy="12" r="7"/>
          <path d="M12 2v2M12 20v2M2 12h2M20 12h2"/>
          <path d="M5 5l1.2 1.2M19 19l-1.2-1.2M5 19l1.2-1.2M19 5l-1.2 1.2"/>
          <path d="M7.5 7.5l0.8 0.8M16.5 16.5l-0.8-0.8M7.5 16.5l0.8-0.8M16.5 7.5l-0.8 0.8"/>
          <path d="M12 5c-2 2-2.5 4.5-1.5 6.5"/>
          <path d="M12 19c2-2 2.5-4.5 1.5-6.5"/>
          <path d="M5 12c2 2 4.5 2.5 6.5 1.5"/>
          <path d="M19 12c-2 2-4.5 2.5-6.5 1.5"/>
          <circle cx="12" cy="12" r="3.5"/>
          <circle cx="12" cy="12" r="2" stroke-dasharray="0.3 0.8"/>
          <circle cx="12" cy="12" r="1" fill="#b8860b"/>
        </svg>
			  </div>
              <h3><a href="{{metadata.url}}" class="inhe">{{hero.vision.title}}</a></h3>
              <p>{{hero.vision.text}}</p>
            </div>
          </div>
          <div style="margin-top:18px" class="feat-card">
            <div class="feat-ico"><span class="steampunk-icon">
			      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 9 15a1.65 1.65 0 0 0-1-1.51V13a2 2 0 0 1 0-4v-.5a1.65 1.65 0 0 0 1-1.51 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 13.5 3c.26 0 .5.1.7.28A1.65 1.65 0 0 0 15 5V5.5a2 2 0 0 1 0 4v.5c0 .6.4 1.1 1 1.5Z"/></svg></span> 
            <a href="{{metadata.url}}" class="inhe">{{hero.notes.title}}</a>
            </div>
            <p style="margin:0;font-size:13.5px;color:var(--sand-dim);line-height:1.6">
            {{hero.notes.text}}
            </p>
          </div>
        </div>
      </div>
    </div>
    <div class="steam-wrap"><div class="wisp"></div><div class="wisp"></div><div class="wisp"></div></div>
  </section>