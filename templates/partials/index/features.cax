<section id="features" class="section">
    <div class="container">
	  <img src="{{features.image}}" 
	    class="rounded centers trans"
	    width="400" height="400" 
	    alt="{{features.alt}}"/>
      <h2 class="section-title"><a href="{{metadata.url}}" class="text-white">{{features.title}}</a></h2>
      <p class="section-sub">{{features.description}}</p>
      <div class="features-grid trans">
        <div class="feat-card"><div class="feat-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="12" cy="12" r="3"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.93 4.93l1.42 1.42M17.66 17.66l1.42 1.42M4.93 19.07l1.42-1.42M17.66 6.34l1.42-1.42"/><circle cx="12" cy="12" r="7" stroke-dasharray="2 2"/></svg></div><h4>{{features.build.title}}</h4><p>{{features.build.text}}</p></div>
        <div class="feat-card"><div class="feat-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="3"/><path d="M7 12h2M15 12h2"/><circle cx="12" cy="12" r="8" stroke-dasharray="3 2"/></svg></div><h4>{{features.binary.title}}</h4><p>{{features.binary.text}}</p></div><div class="feat-card"><div class="feat-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M9 3H5v4"/><path d="M15 3h4v4"/><path d="M9 21H5v-4"/><path d="M15 21h4v-4"/><circle cx="12" cy="12" r="3"/><path d="M12 8V6M12 18v-2M8 12H6M18 12h-2"/></svg></div><h4>{{features.runtime.title}}</h4><p>{{features.runtime.text}}</p></div>
        <div class="feat-card"><div class="feat-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M12 18a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/><circle cx="12" cy="15" r="0.5" fill="currentColor"/></svg></div><h4>{{features.templating.title}}</h4><p>{{features.templating.text}}</p></div>
        <div class="feat-card"><div class="feat-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 9 15a1.65 1.65 0 0 0-1-1.51V13a2 2 0 0 1 0-4v-.5a1.65 1.65 0 0 0 1-1.51 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 13.5 3c.26 0 .5.1.7.28A1.65 1.65 0 0 0 15 5V5.5a2 2 0 0 1 0 4v.5c0 .6.4 1.1 1 1.5Z"/></svg></div><h4>{{features.markdown.title}}</h4><p>{{features.markdown.text}}</p></div>
        <div class="feat-card"><div class="feat-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/><circle cx="12" cy="12" r="2"/></svg></div><h4>{{features.assets.title}}</h4><p>{{features.assets.text}}</p></div>
      </div>
    </div>
</section>