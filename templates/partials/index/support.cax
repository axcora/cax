  <section id="support" class="section">
    <div class="container">
      <h2 class="section-title">{{support.title}}</h2>
      <p class="section-sub">{{support.description}}</p>
      <div class="support-grid trans">
        <div class="sup-card">
          <div class="rivet tl"></div><div class="rivet tr"></div><div class="rivet bl"></div><div class="rivet br"></div>
          <div class="sup-icon">
		  <svg viewBox="0 0 24 24" fill="none" stroke="#b8860b" stroke-width="0.9">
  <circle cx="12" cy="12" r="10"/>
  <circle cx="12" cy="12" r="8.5" stroke-dasharray="0.5 2"/>
  <circle cx="12" cy="12" r="7"/>
  <path d="M12 3v1.5M12 19.5v1.5M3 12h1.5M19.5 12h1.5"/>
  <path d="M5.5 5.5l1 1M17.5 17.5l-1-1M5.5 18.5l1-1M17.5 5.5l-1 1"/>
  <path d="M8 8l1.2 1.2M16 16l-1.2-1.2M8 16l1.2-1.2M16 8l-1.2 1.2"/>
  <path d="M9.5 9.5l0.8 0.8M14.5 14.5l-0.8-0.8M9.5 14.5l0.8-0.8M14.5 9.5l-0.8 0.8"/>
  <circle cx="12" cy="12" r="4.5"/>
  <circle cx="12" cy="12" r="3" stroke-dasharray="0.3 1"/>
  <path d="M10 12h4M12 10v4"/>
  <circle cx="12" cy="12" r="1.2" fill="#b8860b"/>
  <path d="M12 7l1 2.5-1 1.5-1-1.5 1-2.5z" fill="#b8860b" opacity="0.15"/>
  <path d="M12 17l1-2.5-1-1.5-1 1.5 1 2.5z" fill="#b8860b" opacity="0.15"/>
  <path d="M7 12l2.5 1 1.5-1-1.5-1-2.5 1z" fill="#b8860b" opacity="0.15"/>
  <path d="M17 12l-2.5 1-1.5-1 1.5-1 2.5 1z" fill="#b8860b" opacity="0.15"/>
</svg>
		  </div>
          <h4>{{metadata.paypal.name}}</h4><p>{{metadata.paypal.text}}</p>
          <a href="{{metadata.paypal.url}}" class="btn btn-primary" style="font-size:10px;padding:9px 16px">
          {{metadata.paypal.button}}
          </a>
        </div>
        <div class="sup-card">
          <div class="rivet tl"></div><div class="rivet tr"></div><div class="rivet bl"></div><div class="rivet br"></div>
          <div class="sup-icon">
		  <svg viewBox="0 0 24 24" fill="none" stroke="#b8860b" stroke-width="0.9">
  <rect x="2" y="2" width="20" height="20" rx="3"/>
  <rect x="4.5" y="4.5" width="15" height="15" rx="2" stroke-dasharray="0.5 1.5"/>
  <path d="M3 3l1.5 1.5M21 3l-1.5 1.5M3 21l1.5-1.5M21 21l-1.5-1.5"/>
  <path d="M6 6l1.2 1.2M18 18l-1.2-1.2M6 18l1.2-1.2M18 6l-1.2 1.2"/>
  <path d="M12 4v2M12 18v2M4 12h2M18 12h2"/>
  <circle cx="12" cy="12" r="5"/>
  <circle cx="12" cy="12" r="3.5" stroke-dasharray="0.3 1"/>
  <path d="M10 12l2 2 3-3"/>
  <path d="M12 7v5l3 2"/>
  <circle cx="12" cy="12" r="2"/>
  <circle cx="12" cy="12" r="1" fill="#b8860b"/>
  <path d="M12 7c-2 1-3 3-2.5 4.5"/>
  <path d="M12 17c2-1 3-3 2.5-4.5"/>
  <path d="M7 12c1 2 3 3 4.5 2.5"/>
  <path d="M17 12c-1 2-3 3-4.5 2.5"/>
</svg>
		  </div>
          <h4>{{metadata.gumroad.name}}</h4><p>{{metadata.gumroad.text}}</p><a href="{{metadata.gumroad.url}}" class="btn btn-primary" style="font-size:10px;padding:9px 16px">{{metadata.gumroad.button}}</a>
        </div>
        <div class="sup-card">
          <div class="rivet tl"></div><div class="rivet tr"></div><div class="rivet bl"></div><div class="rivet br"></div>
          <div class="sup-icon">
		  <svg viewBox="0 0 24 24" fill="none" stroke="#b8860b" stroke-width="0.9">
  <circle cx="12" cy="12" r="9"/>
  <circle cx="12" cy="12" r="7.5" stroke-dasharray="0.5 2"/>
  <circle cx="12" cy="12" r="6"/>
  <path d="M12 4v1.5M12 18.5v1.5M4 12h1.5M18.5 12h1.5"/>
  <path d="M6 6l1 1M18 18l-1-1M6 18l1-1M18 6l-1 1"/>
  <path d="M8 8l0.8 0.8M16 16l-0.8-0.8M8 16l0.8-0.8M16 8l-0.8 0.8"/>
  <path d="M9 9l0.5 0.5M15 15l-0.5-0.5M9 15l0.5-0.5M15 9l-0.5 0.5"/>
  <path d="M12 6c-2 1.5-2.5 4-1.5 6"/>
  <path d="M12 18c2-1.5 2.5-4 1.5-6"/>
  <path d="M6 12c1.5 2 4 2.5 6 1.5"/>
  <path d="M18 12c-1.5 2-4 2.5-6 1.5"/>
  <circle cx="12" cy="12" r="3.5"/>
  <circle cx="12" cy="12" r="2" stroke-dasharray="0.3 0.8"/>
  <path d="M12 10l2 2-2 2-2-2 2-2z" fill="#b8860b" opacity="0.15"/>
  <circle cx="12" cy="12" r="1" fill="#b8860b"/>
</svg>
		  </div>
          <h4>{{metadata.github.name}}</h4><p>{{metadata.github.text}}</p><a href="{{metadata.github.url}}" class="btn btn-ghost" style="font-size:10px;padding:9px 16px;color:#3e2723;border-color:#b8860b">{{metadata.github.button}}</a>
        </div>
      </div>
    </div>
  </section>